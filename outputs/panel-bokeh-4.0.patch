diff --git a/panel/io/artifact.py b/panel/io/artifact.py
new file mode 100644
index 0000000000000000000000000000000000000000..12828e8992f88f001c0c1b4168baa2487e5222a6
--- /dev/null
+++ b/panel/io/artifact.py
@@ -0,0 +1,145 @@
+"""Panel-owned adapters for Bokeh 4.0 embedding artifacts."""
+from __future__ import annotations
+
+import typing as t
+
+from dataclasses import dataclass
+
+from .resources import BASE_TEMPLATE, _env
+
+if t.TYPE_CHECKING:
+    from collections.abc import Mapping
+
+    from bokeh.embed import EmbedArtifact
+    from bokeh.embed.bundle import Bundle
+    from bokeh.model import Model
+    from jinja2 import Template
+
+
+_ARTIFACT_MACROS = _env.from_string(
+    "{% macro embed(obj) -%}{{ obj.html | safe }}{%- endmacro %}"
+)
+
+
+@dataclass(frozen=True)
+class ArtifactTemplateRoot:
+    """A template root carrying Panel model metadata and Bokeh mount HTML."""
+
+    key: str
+    model: Model | None
+    html: str
+
+    @property
+    def elementid(self) -> str:
+        return self.key
+
+    @property
+    def id(self) -> str:
+        return self.model.id if self.model is not None else self.key
+
+    @property
+    def name(self) -> str:
+        return self.model.name if self.model is not None else self.key
+
+    @property
+    def tags(self) -> list[t.Any]:
+        return self.model.tags if self.model is not None else []
+
+
+@dataclass(frozen=True)
+class ArtifactTemplateRoots:
+    """Sequence and name lookup used by Panel's built-in templates."""
+
+    values: tuple[ArtifactTemplateRoot, ...]
+
+    def __iter__(self):
+        return iter(self.values)
+
+    def __len__(self) -> int:
+        return len(self.values)
+
+    def __getitem__(self, key: int | str) -> ArtifactTemplateRoot:
+        if isinstance(key, int):
+            return self.values[key]
+        for root in self.values:
+            if root.name == key:
+                return root
+        raise ValueError(f"root with {key!r} name not found")
+
+    def __getattr__(self, key: str) -> ArtifactTemplateRoot:
+        return self[key]
+
+
+@dataclass(frozen=True)
+class ArtifactTemplateDocument:
+    """The small document shape consumed by Panel's existing templates."""
+
+    roots: ArtifactTemplateRoots
+    elementid: None = None
+
+
+def render_artifact_page(
+    artifact: EmbedArtifact,
+    models: Mapping[str, Model],
+    bundle: Bundle | tuple[str, str],
+    title: str,
+    *,
+    template: Template | str | None = BASE_TEMPLATE,
+    template_variables: Mapping[str, t.Any] | None = None,
+    base_template: Template = BASE_TEMPLATE,
+) -> str:
+    """Render a Bokeh artifact through Panel's richer template context.
+
+    Bokeh owns artifact serialization and keyed mount declarations. Panel owns
+    its template metadata and its resource bundle, including JavaScript
+    modules, configured raw CSS, and extension ordering.
+    """
+    fragment = artifact.fragment(resources="none")
+    mounts = {mount.key: mount for mount in fragment.mounts}
+    artifact_keys = [root.key for root in artifact.roots]
+    if artifact_keys:
+        if set(artifact_keys) != set(models) or set(artifact_keys) != set(mounts):
+            raise ValueError("Panel artifact models, roots, and mounts must have identical logical keys")
+        root_values = tuple(
+            ArtifactTemplateRoot(key, models[key], mounts[key].html)
+            for key in artifact_keys
+        )
+    else:
+        if models or set(mounts) != {"*"}:
+            raise ValueError("a rootless server artifact must expose exactly its wildcard mount")
+        root_values = (ArtifactTemplateRoot("*", None, mounts["*"].html),)
+    roots = ArtifactTemplateRoots(root_values)
+    doc = ArtifactTemplateDocument(roots)
+    bokeh_js, bokeh_css = bundle
+    context = dict(template_variables or {})
+    context.update(
+        title=title,
+        bokeh_js=bokeh_js,
+        bokeh_css=bokeh_css,
+        plot_script=fragment.script,
+        plot_div="\n".join(root.html for root in root_values),
+        artifact=artifact,
+        artifact_mounts=fragment.mounts,
+        artifact_fragment=fragment.html,
+        docs=[doc],
+        doc=doc,
+        roots=roots,
+        base=base_template,
+        macros=_ARTIFACT_MACROS,
+    )
+
+    if template is None:
+        renderer = base_template
+    elif isinstance(template, str):
+        renderer = _env.from_string("{% extends base %}\n" + template)
+    else:
+        renderer = template
+    return renderer.render(context)
+
+
+__all__ = (
+    "ArtifactTemplateDocument",
+    "ArtifactTemplateRoot",
+    "ArtifactTemplateRoots",
+    "render_artifact_page",
+)
