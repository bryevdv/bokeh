--- /dev/null
+++ b/panel/tests/io/test_artifact.py
@@ -0,0 +1,22 @@
+from bokeh.embed import embed_server
+from bokeh.models import Div
+
+from panel.io.artifact import ArtifactTemplateRoot, render_artifact_page
+
+
+def test_template_root_separates_logical_key_and_semantic_name():
+    model = Div(name="semantic-root")
+    root = ArtifactTemplateRoot("logical-root", model, "<div></div>")
+
+    assert root.key == "logical-root"
+    assert root.name == "semantic-root"
+    assert root.id == model.id
+
+
+def test_render_rootless_server_artifact_uses_wildcard_mount():
+    artifact = embed_server(".", token="test-token")
+
+    html = render_artifact_page(artifact, {}, ("", ""), "Rootless server")
+
+    assert 'data-bokeh-root="*"' in html
+    assert 'Bokeh.mount_artifact_declaration' in html
